<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>ros2_dynamic_path_planning</name>
  <version>2.0.0</version>
  <description>
    A* and D* Lite global planners for Nav2. The algorithms live in a
    ROS-free core library with Dijkstra-validated tests and a seeded
    replanning benchmark; the plugins adapt them to nav2_core.
  </description>

  <maintainer email="munawarsaeedkazmi1@gmail.com">Munawar Kazmi</maintainer>
  <license>MIT</license>

  <author email="munawarsaeedkazmi1@gmail.com">Munawar Kazmi</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <!-- Integration test only: test/test_planner_server_launch.py brings up a
       real planner_server and calls ComputePathToPose against it. -->
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>nav2_planner</test_depend>
  <test_depend>nav2_lifecycle_manager</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/planner_plugins.xml"/>
  </export>

</package>
